<!doctype html>
<html>
<head>
<meta http-equiv="x-ua-compatible" content="IE=11">
<title>Mole Game Replay</title>
<HTA:APPLICATION
    ID="MoleGameStartHere"
    APPLICATIONNAME="Mole Game Replay"
    BORDER="thin"
    CAPTION="yes"
    MAXIMIZEBUTTON="no"
    MINIMIZEBUTTON="yes"
    SCROLL="no"
    SHOWINTASKBAR="yes"
    SINGLEINSTANCE="yes"
    SYSMENU="yes"
    WINDOWSTATE="normal"
/>
<style>
    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        min-width: 560px;
        min-height: 540px;
        overflow: auto;
        box-sizing: border-box;
        font-family: "Segoe UI", Arial, sans-serif;
        background: #f4f7fb;
        color: #172033;
    }

    .shell {
        padding: 22px;
        width: 538px;
    }

    h1 {
        margin: 0 0 6px 0;
        font-size: 26px;
        font-weight: 700;
    }

    .sub {
        margin: 0 0 18px 0;
        color: #526176;
        font-size: 13px;
        line-height: 19px;
    }

    .button {
        width: 100%;
        border: 1px solid #17365d;
        background: #17365d;
        color: #ffffff;
        text-align: left;
        padding: 16px 18px;
        min-height: 74px;
        cursor: pointer;
        border-radius: 6px;
        box-shadow: 0 1px 2px rgba(18, 33, 56, 0.12);
    }

    .button + .button {
        margin-top: 10px;
    }

    .secondary {
        background: #ffffff;
        border-color: #c9d5e6;
        color: #172033;
    }

    .button:hover {
        background: #1f477a;
        border-color: #1f477a;
    }

    .secondary:hover {
        background: #f9fbff;
        border-color: #6b8fc7;
    }

    .label {
        display: block;
        font-size: 17px;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .desc {
        display: block;
        font-size: 12px;
        line-height: 17px;
        color: inherit;
        opacity: 0.84;
    }

    .status {
        margin-top: 16px;
        padding: 11px 13px;
        min-height: 58px;
        border: 1px solid #d6e0ef;
        background: #ffffff;
        border-radius: 6px;
        color: #344258;
        font-size: 12px;
        line-height: 17px;
    }

    .status-text {
        display: table-cell;
        width: 100%;
        min-height: 17px;
        padding-right: 10px;
        vertical-align: top;
        word-break: break-word;
    }

    .status-row {
        display: table;
        width: 100%;
        table-layout: fixed;
    }

    .copy-button {
        display: table-cell;
        width: 64px;
        min-height: 28px;
        border: 1px solid #c9d5e6;
        background: #f9fbff;
        color: #17365d;
        border-radius: 4px;
        cursor: pointer;
        font-size: 12px;
        font-weight: 700;
        text-align: center;
        vertical-align: top;
    }

    .copy-button:hover {
        background: #edf4ff;
        border-color: #6b8fc7;
    }

    .progress {
        display: none;
        margin-top: 9px;
        height: 7px;
        overflow: hidden;
        border-radius: 4px;
        background: #e7edf7;
        border: 1px solid #d6e0ef;
    }

    .progress.active {
        display: block;
    }

    .progress-bar {
        width: 22%;
        height: 100%;
        border-radius: 4px;
        background: #2f6fb3;
    }
</style>
<script language="javascript">
    var shell = new ActiveXObject("WScript.Shell");
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var statusTimer = null;
    var statusTick = 0;
    var statusProgress = 8;
    var statusBaseMessage = "Ready.";
    var statusLogPath = null;
    var copyButtonResetTimer = null;

    function launcherPath() {
        var path = decodeURIComponent(location.pathname);
        if (path.charAt(0) === "/" && path.charAt(2) === ":") {
            path = path.substring(1);
        }
        return path.replace(/\//g, "\\");
    }

    function repoRoot() {
        return fso.GetParentFolderName(launcherPath());
    }

    var ROOT = repoRoot();

    function join(root, relative) {
        return root + "\\" + relative;
    }

    function quote(value) {
        return "\"" + value + "\"";
    }

    function setStatusText(message) {
        document.getElementById("statusText").innerText = message;
    }

    function setCopyButtonLabel(label) {
        document.getElementById("copyStatusButton").innerText = label;
    }

    function copyStatusText() {
        var text = document.getElementById("statusText").innerText;
        if (!text || text.length === 0) {
            text = "";
        }

        var copied = false;
        if (window.clipboardData && window.clipboardData.setData) {
            copied = window.clipboardData.setData("Text", text);
        } else {
            try {
                var textArea = document.createElement("textarea");
                textArea.value = text;
                textArea.style.position = "absolute";
                textArea.style.left = "-9999px";
                document.body.appendChild(textArea);
                textArea.select();
                copied = document.execCommand("copy");
                document.body.removeChild(textArea);
            } catch (error) {
                copied = false;
            }
        }

        if (copyButtonResetTimer !== null) {
            window.clearTimeout(copyButtonResetTimer);
        }
        setCopyButtonLabel(copied ? "Copied" : "Copy");
        copyButtonResetTimer = window.setTimeout(function() {
            setCopyButtonLabel("Copy");
            copyButtonResetTimer = null;
        }, 1200);
    }

    function setProgressVisible(visible) {
        document.getElementById("progress").className = visible ? "progress active" : "progress";
    }

    function setProgress(percent) {
        statusProgress = percent;
        document.getElementById("progressBar").style.width = statusProgress + "%";
    }

    function readLastLogLine(path) {
        if (!path || !fso.FileExists(path)) {
            return "";
        }
        try {
            var file = fso.OpenTextFile(path, 1, false);
            var last = "";
            while (!file.AtEndOfStream) {
                var line = file.ReadLine();
                if (line.length > 0) {
                    last = line;
                }
            }
            file.Close();
            return last;
        } catch (error) {
            return "";
        }
    }

    function stopActiveStatus(message) {
        if (statusTimer !== null) {
            window.clearInterval(statusTimer);
            statusTimer = null;
        }
        setProgressVisible(false);
        setStatusText(message);
    }

    function progressForLogLine(line) {
        if (!line || line.length === 0) {
            return 12;
        }
        if (line.indexOf("Replay:") === 0 || line.indexOf("Divergence log:") === 0) {
            return 24;
        }
        if (line.indexOf("SDL3 runtime not found") >= 0 || line.indexOf("SDL3 already available") >= 0) {
            return 42;
        }
        if (line.indexOf("Runtime source newer than release exe") >= 0 || line.indexOf("Building release runtime") >= 0) {
            return 60;
        }
        if (line.indexOf("Using fresh release runtime") >= 0) {
            return 76;
        }
        if (line.indexOf("Launching Mole Rust SDL3 Slippi replay runtime") >= 0) {
            return 100;
        }
        if (line.indexOf("Runtime exited with") >= 0 || line.indexOf("failed") >= 0 || line.indexOf("Missing replay") >= 0) {
            return 100;
        }
        return statusProgress;
    }

    function startActiveStatus(message, logRelativePath) {
        if (statusTimer !== null) {
            window.clearInterval(statusTimer);
        }
        statusTick = 0;
        statusBaseMessage = message;
        statusLogPath = logRelativePath ? join(ROOT, logRelativePath) : null;
        setProgressVisible(true);
        setStatusText(message);
        setProgress(12);
        statusTimer = window.setInterval(function() {
            statusTick += 1;
            var dots = "";
            for (var i = 0; i < (statusTick % 4); i += 1) {
                dots += ".";
            }
            var logLine = readLastLogLine(statusLogPath);
            setProgress(progressForLogLine(logLine));
            if (logLine.length > 0) {
                setStatusText(statusBaseMessage + dots + "\n" + logLine);
            } else {
                setStatusText(statusBaseMessage + dots);
            }
        }, 450);
    }

    function run(command, windowStyle) {
        try {
            shell.Run(command, windowStyle, false);
        } catch (error) {
            alert("Could not start this action.\n\n" + error.message);
        }
    }

    function runCommandFileHidden(relativePath, label, logRelativePath) {
        var target = join(ROOT, relativePath);
        if (!fso.FileExists(target)) {
            alert("Missing launcher:\n" + target);
            return;
        }
        startActiveStatus(label + " is starting. The SDL window will open when the runtime is ready.", logRelativePath);
        var cmd = shell.ExpandEnvironmentStrings("%ComSpec%");
        run(quote(cmd) + " /d /c " + quote(target), 0);
    }

    function runCommandFileVisible(relativePath, label) {
        var target = join(ROOT, relativePath);
        if (!fso.FileExists(target)) {
            alert("Missing launcher:\n" + target);
            return;
        }
        startActiveStatus(label + " is starting.", null);
        var cmd = shell.ExpandEnvironmentStrings("%ComSpec%");
        run(quote(cmd) + " /d /c " + quote(target), 1);
    }

    function launchReplay() {
        runCommandFileHidden("execs\\Play Slippi Replay.cmd", "Replay. Divergence log: debug\\slippi\\runtime-divergence.latest.json", "debug\\slippi\\runtime-launch.latest.log");
    }

    function launchLocalPlay() {
        runCommandFileHidden("execs\\Run Local SDL3 Runtime.cmd", "Local play");
    }

    function launchDevtool() {
        runCommandFileVisible("execs\\Open Dev Tool.cmd", "Dev tool");
    }

    window.onload = function() {
        window.resizeTo(600, 580);
        stopActiveStatus("Ready.");
    };
</script>
</head>
<body>
    <div class="shell">
        <h1>Mole Game Replay</h1>
        <p class="sub">
            Launches the local Slippi replay directly through the Rust runtime and stops on the first parity divergence.
        </p>

        <button class="button" onclick="launchReplay()">
            <span class="label">Play Replay From Start</span>
            <span class="desc">Writes the live divergence log and holds on the first mismatch.</span>
        </button>

        <button class="button secondary" onclick="launchLocalPlay()">
            <span class="label">Play Locally</span>
            <span class="desc">Starts the Rust SDL3 local runtime for direct testing.</span>
        </button>

        <button class="button secondary" onclick="launchDevtool()">
            <span class="label">Open Dev Tool</span>
            <span class="desc">Opens the state graphs, replay tools, ledgers, and traces.</span>
        </button>

        <div id="status" class="status">
            <div class="status-row">
                <div id="statusText" class="status-text">Ready.</div>
                <button id="copyStatusButton" class="copy-button" onclick="copyStatusText()" title="Copy status summary">Copy</button>
            </div>
            <div id="progress" class="progress">
                <div id="progressBar" class="progress-bar"></div>
            </div>
        </div>
    </div>
</body>
</html>
