<!doctype html>
<html>
<head>
<meta http-equiv="x-ua-compatible" content="IE=11">
<title>Mole Game Replay</title>
<HTA:APPLICATION
    ID="MoleGameStartHere"
    APPLICATIONNAME="Mole Game Replay"
    BORDER="thin"
    CAPTION="yes"
    MAXIMIZEBUTTON="no"
    MINIMIZEBUTTON="yes"
    SCROLL="no"
    SHOWINTASKBAR="yes"
    SINGLEINSTANCE="yes"
    SYSMENU="yes"
    WINDOWSTATE="normal"
/>
<style>
    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        min-width: 560px;
        min-height: 450px;
        overflow: auto;
        box-sizing: border-box;
        font-family: "Segoe UI", Arial, sans-serif;
        background: #f4f7fb;
        color: #172033;
    }

    .shell {
        padding: 22px;
        width: 538px;
    }

    h1 {
        margin: 0 0 6px 0;
        font-size: 26px;
        font-weight: 700;
    }

    .sub {
        margin: 0 0 18px 0;
        color: #526176;
        font-size: 13px;
        line-height: 19px;
    }

    .button {
        width: 100%;
        border: 1px solid #17365d;
        background: #17365d;
        color: #ffffff;
        text-align: left;
        padding: 16px 18px;
        min-height: 74px;
        cursor: pointer;
        border-radius: 6px;
        box-shadow: 0 1px 2px rgba(18, 33, 56, 0.12);
    }

    .button + .button {
        margin-top: 10px;
    }

    .secondary {
        background: #ffffff;
        border-color: #c9d5e6;
        color: #172033;
    }

    .button:hover {
        background: #1f477a;
        border-color: #1f477a;
    }

    .secondary:hover {
        background: #f9fbff;
        border-color: #6b8fc7;
    }

    .label {
        display: block;
        font-size: 17px;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .desc {
        display: block;
        font-size: 12px;
        line-height: 17px;
        color: inherit;
        opacity: 0.84;
    }

    .status {
        margin-top: 16px;
        padding: 11px 13px;
        min-height: 40px;
        border: 1px solid #d6e0ef;
        background: #ffffff;
        border-radius: 6px;
        color: #344258;
        font-size: 12px;
        line-height: 17px;
    }
</style>
<script language="javascript">
    var shell = new ActiveXObject("WScript.Shell");
    var fso = new ActiveXObject("Scripting.FileSystemObject");

    function launcherPath() {
        var path = decodeURIComponent(location.pathname);
        if (path.charAt(0) === "/" && path.charAt(2) === ":") {
            path = path.substring(1);
        }
        return path.replace(/\//g, "\\");
    }

    function repoRoot() {
        return fso.GetParentFolderName(launcherPath());
    }

    var ROOT = repoRoot();

    function join(root, relative) {
        return root + "\\" + relative;
    }

    function quote(value) {
        return "\"" + value + "\"";
    }

    function setStatus(message) {
        document.getElementById("status").innerText = message;
    }

    function run(command, windowStyle) {
        try {
            shell.Run(command, windowStyle, false);
        } catch (error) {
            alert("Could not start this action.\n\n" + error.message);
        }
    }

    function runCommandFileHidden(relativePath, label) {
        var target = join(ROOT, relativePath);
        if (!fso.FileExists(target)) {
            alert("Missing launcher:\n" + target);
            return;
        }
        setStatus(label + " is starting. The SDL window will open when the runtime is ready. Divergence log: debug\\slippi\\runtime-divergence.latest.json");
        var cmd = shell.ExpandEnvironmentStrings("%ComSpec%");
        run(quote(cmd) + " /d /c " + quote(target), 0);
    }

    function runCommandFileVisible(relativePath, label) {
        var target = join(ROOT, relativePath);
        if (!fso.FileExists(target)) {
            alert("Missing launcher:\n" + target);
            return;
        }
        setStatus(label + " is starting.");
        var cmd = shell.ExpandEnvironmentStrings("%ComSpec%");
        run(quote(cmd) + " /d /c " + quote(target), 1);
    }

    function launchReplay() {
        runCommandFileHidden("execs\\Play Slippi Replay.cmd", "Replay");
    }

    function launchLocalPlay() {
        runCommandFileHidden("execs\\Run SDL3 Runtime.cmd", "Local play");
    }

    function launchDevtool() {
        runCommandFileVisible("execs\\Open Dev Tool.cmd", "Dev tool");
    }

    window.onload = function() {
        window.resizeTo(600, 500);
    };
</script>
</head>
<body>
    <div class="shell">
        <h1>Mole Game Replay</h1>
        <p class="sub">
            Launches the local Slippi replay directly through the Rust runtime and stops on the first parity divergence.
        </p>

        <button class="button" onclick="launchReplay()">
            <span class="label">Play Replay From Start</span>
            <span class="desc">Writes the live divergence log and holds on the first mismatch.</span>
        </button>

        <button class="button secondary" onclick="launchLocalPlay()">
            <span class="label">Play Locally</span>
            <span class="desc">Starts the Rust SDL3 local runtime for direct testing.</span>
        </button>

        <button class="button secondary" onclick="launchDevtool()">
            <span class="label">Open Dev Tool</span>
            <span class="desc">Opens the state graphs, replay tools, ledgers, and traces.</span>
        </button>

        <div id="status" class="status">
            Ready.
        </div>
    </div>
</body>
</html>
